DRY_RUN=true
LIVE_TRADING=false
SCAN_INTERVAL_MS=1000
ORDER_FILL_TIMEOUT_MS=1500
DASHBOARD_PORT=3000
DB_PATH=./bot.sqlite
SEED_DEMO_DATA=false

KALSHI_ENV=demo
KALSHI_API_BASE_URL=https://demo-api.kalshi.co

TARGET_PRICE_CENTS=98
WINDOW_SEC=15
EXACT_PRICE_ONLY=true
MAX_RISK_PER_TRADE_USD=10
MAX_OPEN_POSITIONS=1
DAILY_LOSS_LIMIT_USD=25
MIN_LIQUIDITY_CONTRACTS=10
MIN_QUALITY_SCORE=70
MIN_EDGE=0.03
MIN_FILL_PROB=0.6

STRATEGY_MODE=NEAR_EXPIRY_98C
EXTERNAL_BUFFER_USD=25
WEATHER_PROVIDER=none
WEATHER_ENABLE=true
WEATHER_PROVIDER_ENDPOINT=
WEATHER_PROVIDER_API_KEY=
SPORTS_PROVIDER=none
SPORTS_PROVIDER_ENDPOINT=
MAX_TOTAL_EXPOSURE_USD=100
MAX_PER_SYMBOL_EXPOSURE_USD=40
MAX_PER_LOCATION_EXPOSURE_USD=40
CORRELATION_GUARD=true
FEE_RATE=0

LADDER_START_SIZE_USD=1
LADDER_STEP_USD=1
LADDER_CONSECUTIVE_WINS_STEP=25
LADDER_TRADES_WINDOW=100
LADDER_MIN_WINRATE=0.6
LADDER_MIN_FILL_RATE=0.2

TELEGRAM_NOTIFY=false
OPENCLAW_SEND_CMD=openclaw
COMMANDS_FILE_PATH=./commands.txt
ALLOW_DRYRUN_TOGGLE=true
DASHBOARD_ALLOW_CONTROL=true

LOCAL_MASTER_KEY=replace-with-long-random-secret
